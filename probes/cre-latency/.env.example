# Deployer key for the LatencyProbe contract on Monad mainnet.
# Needs a small amount of MON for gas.
DEPLOYER_PRIVATE_KEY=

# Set after running scripts/deploy.sh
PROBE_ADDRESS=

# Optional overrides
MONAD_RPC_URL=https://rpc.monad.xyz
SAMPLE_TIMEOUT=300

# Used by `cre workflow simulate --broadcast` for the local-execution fallback
CRE_ETH_PRIVATE_KEY=
